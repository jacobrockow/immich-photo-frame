# Photo Frame device configuration
#
# Copy this file outside the repository or to pi/device.env for a private,
# builder-specific configuration. pi/device.env is ignored by Git.

# Public origin of the Photo Frame server this device belongs to.
# Leave blank for a generic/unprovisioned device. A future local bootstrap
# agent will allow this to be configured without exposing the OS.
PHOTOFRAME_URL=https://frame.example.com

# Friendly, stable identity for the physical device. install.sh generates one
# automatically when omitted and preserves it across reinstalls.
DEVICE_ID=

# When true, a factory reset should preserve PHOTOFRAME_URL. Use this for
# devices preconfigured by a builder for a specific Photo Frame deployment.
PHOTOFRAME_URL_LOCKED=true
