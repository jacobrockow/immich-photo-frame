# Shared by local compose.yml and production compose.prod.yml.
# Copy to .env and adjust for your environment.

DATABASE_URL=sqlite:////data/photoframe.db

# Local compose.yml: browser talks to :5173 (UI) and :8000 (API).
# Production compose.prod.yml: same-origin /api via Nginx — leave empty or unset.
CORS_ORIGINS=http://localhost:5173

DEFAULT_IMMICH_URL=https://immich.example.com
SESSION_DAYS=30
KIOSK_PAGE_SIZE=100
# Candidate pool size. Sampling uses Immich /search/random so this is not
# "newest N only" — older years can still appear.
KIOSK_MAX_ASSETS=1000
KIOSK_FETCH_CAP=3000
OPENWEATHER_API_KEY=

# Production only (compose.prod.yml): host port for the Nginx frontend.
# FRONTEND_PORT=80
